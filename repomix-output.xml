@import "tailwindcss";

/* Palette: cool paper, indigo ink. The loud colours live in lib/seasons.ts (one per month). */
:root {
  --ground: #edeff3;
  --surface: #ffffff;
  --ink: #1b2140;
  --muted: #5c6480;
  --line: #d3d8e2;
  --line-strong: #b6bdcc;
}

@media (prefers-color-scheme: dark) {
  :root {
    --ground: #12162a;
    --surface: #1b2140;
    --ink: #e9ecf6;
    --muted: #9aa3be;
    --line: #2b3358;
    --line-strong: #434c75;
  }
}

@theme inline {
  --color-ground: var(--ground);
  --color-surface: var(--surface);
  --color-ink: var(--ink);
  --color-muted: var(--muted);
  --color-line: var(--line);
  --color-line-strong: var(--line-strong);
  --font-display: "Bricolage Grotesque Variable", ui-sans-serif, system-ui, sans-serif;
  --font-sans: "Instrument Sans Variable", ui-sans-serif, system-ui, sans-serif;
}

body {
  background: var(--ground);
  color: var(--ink);
  font-family: var(--font-sans);
}

:focus-visible {
  outline: 2px solid var(--ink);
  outline-offset: 2px;
}

/* React Flow: use our palette instead of its defaults */
.react-flow {
  --xy-background-color: var(--ground);
  --xy-edge-stroke-default: var(--line-strong);
  --xy-controls-button-background-color: var(--surface);
  --xy-controls-button-background-color-hover: var(--ground);
  --xy-controls-button-color: var(--ink);
  --xy-controls-button-border-color: var(--line);
  --xy-attribution-background-color: transparent;
}
.react-flow__node {
  cursor: pointer;
}

/* Home screen: soft colour wash behind the hero, and a gentle entrance. */
.hero-bg {
  background:
    radial-gradient(48rem 24rem at 12% -8%, color-mix(in srgb, #2fa66a 16%, transparent), transparent 62%),
    radial-gradient(44rem 24rem at 100% 8%, color-mix(in srgb, #6a6cf0 18%, transparent), transparent 62%),
    radial-gradient(40rem 22rem at 55% 115%, color-mix(in srgb, #e3a008 14%, transparent), transparent 62%);
}
@keyframes rise {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: none; }
}
.rise {
  animation: rise 0.55s cubic-bezier(0.2, 0.7, 0.2, 1) both;
}
@media (prefers-reduced-motion: reduce) {
  .rise { animation: none; }
}

/* Graph nodes: pop in with a little overshoot. */
@keyframes bubble-in {
  from { opacity: 0; transform: scale(0.2); }
  to { opacity: 1; transform: none; }
}
.bubble-in {
  animation: bubble-in 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}
@media (prefers-reduced-motion: reduce) {
  .bubble-in { animation: none; }
}
