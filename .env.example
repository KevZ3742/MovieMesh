# Optional. Without a TMDB key the app still works from catalog.db,
# but you get no posters, plot summaries or cast (so no actor nodes in the mesh).
# Use ONE of these (TMDB account > Settings > API):
TMDB_READ_TOKEN=
TMDB_API_KEY=

# Optional: path to the catalog if it isn't at data/catalog.db
# CATALOG_DB=
